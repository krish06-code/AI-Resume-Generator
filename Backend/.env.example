# MongoDB connection string (MongoDB Atlas for production)
MONGO_URI=

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=

# Google Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_GENAI_API_KEY=

# Your deployed frontend's URL, used for CORS. Example: https://vantage.vercel.app
# Leave unset for local dev — it falls back to http://localhost:5173
FRONTEND_URL=

# Set to "production" when deployed. Controls cookie security flags
# (secure + sameSite=none in production, lax + non-secure locally).
NODE_ENV=

# Most hosts (Render, Railway, etc.) inject this automatically — you
# usually don't need to set it yourself.
PORT=
